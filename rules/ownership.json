{
  "file": "ownership.json",
  "version": "2.0.0",
  "reading": "Cap-table and ownership-chain decisions. Ordered rules, first match wins, exceptions on top. All arithmetic is exact (fractions); no float, no rounding, no tolerance.",
  "parameters": {
    "sum_must_equal": {
      "value": "1/1",
      "status": "[TO CONFIRM with legal]",
      "note": "The holders of an entity must sum to exactly the whole. 99.99% and 100.01% are both refused. Whether a real cap table may legitimately not sum to the whole (treasury shares, unallotted capital) is a legal question and is not modelled."
    },
    "cycle_policy": {
      "value": "abstain",
      "allowed": [
        "abstain",
        "closure"
      ],
      "status": "[TO CONFIRM with legal]",
      "note": "With cross-holdings the look-through to natural persons depends on a rule. 'abstain' reports the cycle and writes the effective holding [TO CONFIRM]. 'closure' computes the exact limit of the look-through (the solution of x = direct + cross * x, in fractions) and says so next to each figure."
    }
  },
  "rules": [
    {
      "id": "OWN-010",
      "when": "holder_table_sum_not_whole",
      "outcome": "BLOCKED",
      "rationale": "Exception on top of everything: a holders' table that does not sum to the whole blocks the build of that entity. It is never rendered and never footnoted.",
      "tests": [
        {
          "tables": {
            "E-0001": [
              [
                "P-001",
                "3333/10000"
              ],
              [
                "P-002",
                "3333/10000"
              ],
              [
                "P-003",
                "3333/10000"
              ]
            ]
          },
          "target": "E-0001",
          "expect": {
            "outcome": "BLOCKED",
            "sum": "9999/10000"
          }
        }
      ]
    },
    {
      "id": "OWN-020",
      "when": "holders_not_stated",
      "outcome": "TO_CONFIRM",
      "rationale": "The holders of the entity are in discrepancy or could not be read: there is no single table to look through.",
      "tests": [
        {
          "tables": {
            "E-0001": null
          },
          "target": "E-0001",
          "expect": {
            "outcome": "TO_CONFIRM"
          }
        }
      ]
    },
    {
      "id": "OWN-030",
      "when": "upstream_not_resolved",
      "outcome": "TO_CONFIRM",
      "rationale": "A holder up the chain has no single readable table (discrepancy, unreadable, blocked, or not in the dossier set): the chain stops there and the effective holding is not guessed.",
      "tests": [
        {
          "tables": {
            "E-0001": [
              [
                "E-0002",
                "1/1"
              ]
            ],
            "E-0002": null
          },
          "target": "E-0001",
          "expect": {
            "outcome": "TO_CONFIRM"
          }
        }
      ]
    },
    {
      "id": "OWN-040",
      "when": "cycle_upstream",
      "outcome": "{cycle_policy}",
      "rationale": "The chain enters a cross-holding. The cycle is reported; the effective holding follows the declared cycle_policy [TO CONFIRM with legal].",
      "tests": [
        {
          "tables": {
            "E-0001": [
              [
                "P-001",
                "9/10"
              ],
              [
                "E-0002",
                "1/10"
              ]
            ],
            "E-0002": [
              [
                "P-002",
                "4/5"
              ],
              [
                "E-0001",
                "1/5"
              ]
            ]
          },
          "target": "E-0001",
          "cycle_policy": "abstain",
          "expect": {
            "outcome": "TO_CONFIRM",
            "cycles": [
              [
                "E-0001",
                "E-0002"
              ]
            ]
          }
        },
        {
          "tables": {
            "E-0001": [
              [
                "P-001",
                "9/10"
              ],
              [
                "E-0002",
                "1/10"
              ]
            ],
            "E-0002": [
              [
                "P-002",
                "4/5"
              ],
              [
                "E-0001",
                "1/5"
              ]
            ]
          },
          "target": "E-0001",
          "cycle_policy": "closure",
          "expect": {
            "outcome": "RESOLVED",
            "cycles": [
              [
                "E-0001",
                "E-0002"
              ]
            ],
            "effective": {
              "P-001": "45/49",
              "P-002": "4/49"
            }
          }
        }
      ]
    },
    {
      "id": "OWN-050",
      "when": "always",
      "outcome": "RESOLVED",
      "rationale": "Default: look through every entity holder up to natural persons, multiplying and adding exact fractions.",
      "tests": [
        {
          "tables": {
            "E-0001": [
              [
                "P-001",
                "3/5"
              ],
              [
                "E-0002",
                "2/5"
              ]
            ],
            "E-0002": [
              [
                "P-001",
                "1/2"
              ],
              [
                "P-002",
                "1/2"
              ]
            ]
          },
          "target": "E-0001",
          "expect": {
            "outcome": "RESOLVED",
            "effective": {
              "P-001": "4/5",
              "P-002": "1/5"
            }
          }
        },
        {
          "tables": {
            "E-0001": [
              [
                "P-001",
                "1/3"
              ],
              [
                "P-002",
                "1/3"
              ],
              [
                "P-003",
                "1/3"
              ]
            ]
          },
          "target": "E-0001",
          "expect": {
            "outcome": "RESOLVED",
            "effective": {
              "P-001": "1/3",
              "P-002": "1/3",
              "P-003": "1/3"
            }
          }
        }
      ]
    }
  ]
}
